    "StringSets" : [
        {
            "Key" : "NewBeginning_QuickStartSeeds",
            "StringSet" : [
                // Any ship generation change can rebuild these differently. Re-check them
                // after one: a single island, no reroll, and the stasis array a few rooms
                // away from the computer, so the player reaches it later.

                // stasis far aft, 23 tiles from the computer
                "New York Armstrong",

                // ring-like hull, stasis 27 tiles from the computer
                "Elara",

                // broad hull, stasis 20 tiles from the computer
                "Ceres Hope",

                // stasis 15 tiles from the computer
                "Vega Harbor",

                // mirrored cross, stasis 14 tiles from the computer
                "Gaia Seed"
            ]
        },
        {
            "Key" : "NewBeginning_UnlockedResearch",
            "StringSet" : [
                // Research/Production/AssemblyImproved (the Assembler) is not listed here on
                // purpose: the scenario grants it in code only when the intro found nobody who
                // can run the Crafting Station, see
                // BaseRandomShipScenario.UnlockAssemblerIfCrewCannotCraft.
                //
                // Gears carry their own research gate (Obj/Materials/Gears requires this
                // node), and the crafter UI hides locked products. The manual quest
                // researches it as its first step; the Assembler variant has no research
                // step, so without this a Basic Tech setting other than Unlocked leaves the
                // Assembler unable to be configured to Gears and the chain stalls.
                "Research/Production/Assembly",

                // New Beginning starts with Basic Tech Locked (Scenario.DefaultBasicTech), so
                // research decides what the build menu grows into. These Basic nodes stay open.
                // Locked on purpose: Winch, AtmosphereControl and Bridge/Propulsion (the stasis
                // and flight quests research them, after a HaveResearchDatoids step) and Solar.

                // Basics for living and tidying up
                "Research/LifeSupport/Hygiene",
                "Research/Habitation/Storage",
                "Research/Construction/Lighting",
                "Research/Entertainment/Treadmill",
                // The first colonist can wake with no datoids saved while the stasis rations
                // last 2-3 days, so food is never behind research
                "Research/LifeSupport/FoodProduction",
                // Survival meals are protein and water, and no quest teaches the extractor
                "Research/Production/BiochemicalExtraction",
                // Tech datoids and transistor/microchip crafting hang on it
                "Research/Production/Electronics",
                // The radar costs Tech and Energy datoids, and Energy datoids need
                // ReactorEfficiency: too much before the first expedition, which is the way
                // to new copper. Communications is its prerequisite.
                "Research/Scanning/Communications",
                "Research/Scanning/Radar",
                // No build items, so locking them would shrink nothing
                "Research/Production/Weaving",
                "Research/Security/WeaponsBasic",
                "Research/Economy/Wallet",
                "Research/Economy/OnlineShop"
            ]
        },
