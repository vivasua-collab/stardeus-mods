        // how much % sanity glides toward SanityTarget per day
        { "Key" : "SanityRecoveryPerHour", "Float" : 0.04 },
        // how much % sanity glides toward SanityTarget per day
        { "Key" : "SanityDropPerHour", "Float" : 0.03 },
        // how hard the sanity effects affect the sanity base threshold
        // too much = too many breakdowns, too little = sanity won't swing enough and it's boring
        { "Key" : "SanityEffectImpact", "Float" : 0.02 },
        // Mental breakdown threshold bands: a being becomes eligible for light/medium/heavy
        // breakdown checks once its Sanity drops at or below these values. Defaults seed the
        // per-being threshold stats; traits (e.g. Enlightened) tune them via stat modifiers.
        { "Key" : "BreakdownLightThreshold", "Float" : 0.31 },
        { "Key" : "BreakdownMediumThreshold", "Float" : 0.20 },
        { "Key" : "BreakdownHeavyThreshold", "Float" : 0.05 },
        // Mean Time Between breakdowns (in days) per band. Per-hour chance = 1 / (days * 24).
        { "Key" : "BreakdownLightMtbDays", "Float" : 10.0 },
        { "Key" : "BreakdownMediumMtbDays", "Float" : 3.0 },
        { "Key" : "BreakdownHeavyMtbDays", "Float" : 0.7 },
        // Relief: temporary mood boost applied when a breakdown ends, suppressing re-breaks.
        { "Key" : "BreakdownReliefDays", "Float" : 2.5 },
        { "Key" : "GroundedBeingDirtSpawnChance", "Float" : 0.01 },
        // Worn gear at or below this quality is "tattered" and depresses its wearer.
        // Nothing procgen or traders produce falls this low - it is reachable through
        // crafting by an unskilled colonist, which is the point of it.
        { "Key" : "TatteredQualityThreshold", "Float" : 0.4 },
        // How long a being remembers using a fun source. Uses fade linearly over this window,
        // repeated recent uses make the source give less fun and mood.
        { "Key" : "FunRepetitionWindowDays", "Float" : 7.0 }
    ],
