{
    "Floats" : [
        { "Key" : "FriendlyFightMaxDurationHours", "Float" : 6.0 },
        { "Key" : "FriendlyFightStallTimeoutHours", "Float" : 3.0 },
        { "Key" : "BreachCapsuleSpeedMul", "Float" : 1.0 },
        { "Key" : "AccuracyBonusAfterEachMiss", "Float" : 0.1 },
        // Skill XP per tick of an attack's cycle (charge + cooldown), paid per attack at a
        // target that can fight back, hit or miss: fast and slow weapons train at the same rate
        // per hour of fighting, and Melee a little faster than Shooting
        { "Key" : "CombatShootingXpPerCycleTick", "Float" : 118.0 },
        // Melee weapons have no accuracy: a melee hit lands by the attacker's MeleeAccuracy.
        // Weapon choice, attack priority and raid pricing weigh melee attacks by this typical
        // hit chance instead (a skill 5 fighter's 65%)
        { "Key" : "CombatMeleeReferenceHitChance", "Float" : 0.65 },
        // Distance at which ShootingAccuracy (skill, Sight, Dexterity) applies as it is; a shot
        // raises the stat to distance / this, as accuracy per tile of range. Closer shots depend
        // less on the shooter, longer ones more
        { "Key" : "CombatSkillReferenceDistance", "Float" : 12.0 },
        { "Key" : "CombatMeleeXpPerCycleTick", "Float" : 139.0 },
        // Most of a hit chance that cover can take away. Below 1, so full cover (100) never
        // makes a unit that can still shoot back impossible to hit
        { "Key" : "CombatMaxCoverReduction", "Float" : 0.9 },
        // A shot flies on (StrayShot): the chance a standing being on its way takes it, times
        // its body size (full from 12 tiles of the shooter, none within 5), a tenth of that
        // for a lying being, 0.4 of it for a friendly one, and how much of a cover object's
        // CoverPercent counts when it is not right by where the shot lands
        { "Key" : "CombatStrayShotInterceptChance", "Float" : 0.4 },
        { "Key" : "CombatStrayShotDownedMul", "Float" : 0.1 },
        { "Key" : "CombatStrayShotFriendlyMul", "Float" : 0.4 },
        { "Key" : "CombatStrayShotObjectInterceptMul", "Float" : 0.15 },
        // Share of a stray shot's damage a wall or a door takes, so misses do not breach the ship
        { "Key" : "CombatStrayShotWallDamageMul", "Float" : 0.25 },
        // Highest chance to dodge a melee hit (MeleeDodge stat)
        { "Key" : "CombatMaxMeleeDodge", "Float" : 0.5 },
        // Scales a weapon's FatalHitChanceMul when a hit would destroy a part the being cannot
        // live without (body, head, heart), so fights end mostly in downs rather than deaths
        { "Key" : "CombatVitalPartDestroyMul", "Float" : 0.5 },
        // How long after a fight starts its attackers still go after ship weapons (turrets
        // that never fire at beings, often out on the hull where no colonist can reach them).
