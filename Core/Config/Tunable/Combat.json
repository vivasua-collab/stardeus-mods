        { "Key" : "CombatNoContactEndHours", "Float" : 6.0 },
        { "Key" : "CombatCooldownMultiplier", "Float" : 1.5 },
        { "Key" : "CombatChargeMultiplier", "Float" : 1.25 },
        { "Key" : "CombatMeleeEscapeHpThreshold", "Float" : 0.25 },
