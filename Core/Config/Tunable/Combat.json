        { "Key" : "CombatCommandRadius", "Float" : 6.0 },
        { "Key" : "CombatCommandAccuracyMul", "Float" : 1.15 },
        { "Key" : "CombatEnemyFleeHpThreshold", "Float" : 0.35 },
        { "Key" : "CombatEnemyRouteThreshold", "Float" : 0.50 },
        { "Key" : "CombatEnemyRoutFleeChance", "Float" : 0.50 },
        { "Key" : "CombatSuppressionThreshold", "Float" : 0.35 },
        { "Key" : "CombatSuppressionPerHit", "Float" : 0.4 },
        { "Key" : "CombatSuppressionPerNearMiss", "Float" : 0.2 },
        { "Key" : "CombatSuppressionPerMeleeHit", "Float" : 0.15 },
        { "Key" : "CombatSuppressionDecayMinutes", "Float" : 30.0 },
        { "Key" : "CombatSuppressedAttackChance", "Float" : 0.50 },
        { "Key" : "CombatStunSuppressionAmount", "Float" : 0.2 },
        { "Key" : "CombatStunSuppressionExtraMinutes", "Float" : 15.0 },
        { "Key" : "CombatSuppressedMoveSpeedMul", "Float" : 0.25 },
        { "Key" : "CombatSkipMeleeAttackWhileMovingChance", "Float" : 0.50 },
        { "Key" : "CombatMeleeNoTargetWaitMinutes", "Float" : 5.0 },
        { "Key" : "CombatRangedNoTargetWaitMinutes", "Float" : 20.0 },
