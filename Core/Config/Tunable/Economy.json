        { "Key" : "TradeSecondHandPriceMul", "Float" : 0.5 },
        { "Key" : "TradeDeadMansPriceMul", "Float" : 0.25 },

        // Net worth of finished structures (NetWorthCalculator.WorthOfStructure):
        // credits added per ship class point for ship-combat devices (weapons, shields,
        // capacitors, engines, vents), on top of materials x Curves/Economy/StructureTierValueMul.
        // Class points are the authored measure of how much of a ship's combat budget a device
        // takes, i.e. what it is worth to the ship - a shield emitter (8 CP) is ~13k, about
        // three top-grade rifles, instead of the 1.3k its parts come to.
        { "Key" : "StructureClassPointValue", "Float" : 1500.0 },
        // Fraction of structure value that counts toward raid threat wealth
        // (CombatRaid.ThreatNetWorth), the rest of net worth counting at 1. Popular colony sim's
        // storyteller counts buildings at 0.5 so that building infrastructure out of a stockpile
        // is rewarded over hoarding the same value loose. Held at 1.0 for now: structures were
        // undervalued (materials only) until the tier/class-point valuation above, and the
        // discount is worth deciding on once that is calibrated rather than stacking the two.
        { "Key" : "StructureThreatWeight", "Float" : 1.0 }
