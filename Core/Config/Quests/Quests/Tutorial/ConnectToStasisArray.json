{
    "QuestFlags" : [ "Tutorial", "AutoAdd", "Unique" ],
    "TitleKey" : "quest.ConnectToStasisArray",
    "DescKey" : "quest.ConnectToStasisArray.desc",
    "QuestProviders" : [
        "ShipComputer"
    ],
    // Gated on research, not on the survivor area: that quest now sits in slot two, and
    // keying off its bool would pull the stasis run forward next to production.
    "AvailableWhen" : [
        "ReadyForTutorialQuests",
        "HasEstablishedResearch"
    ],
    // In scenarios without a survivor area this is the quest that teaches unifying the
    // grid, so it has to advertise the page ConnectToSurvivorArea advertises elsewhere.
    // Where both quests run, this one asks second and is dropped as already seen.
    // OnStartTutorialId is implicitly bound, so it only counts down while tracked.
    "OnStartTutorialId": "Electricity/UnifyingGrid",
    "OnStartTutorialDelay": 10,
    "SetOnComplete" : [ "ConnectedToStasis" ],
    // if tutorial quest gets abandoned, we still want to move on with the other tutorials
    "SetOnFail" : [ "ConnectedToStasis" ],
