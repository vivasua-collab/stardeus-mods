                { "Key" : "POIConfigId", "String" : "Port" },
                { "Key" : "FactionId", "String" : "Sentinel" },
                { "Key" : "Var_Start", "String" : null },
                { "Key" : "SkipRegionsWithoutRelay", "Bool" : false },
                { "Key" : "SharedVar_SavePOIId", "String" : "Main_SentinelHQId" }
            ]
        }
    ],
    "Steps" : [
