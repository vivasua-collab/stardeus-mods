{
    // This is the official Stardeus UI theme.
    //
    // When developing your own custom themes, you can use these in-game tools:
    // 1. Open console with ~
    // 2. "theme debug" console command will open a debug window
    // 3. "theme reload" console command will apply the theme changes
    //    from the JSON file without restart.
    //
    // TIP: When making your own theme, don't copy everything from this file,
    // only copy things you want to override.
    // You will most likely want to change some of the colors in "Colors" block.
    // See other themes as examples.
    "Name": "Default",
    "Colors": {
        "White": "#DEDEDE",
        "Black": "#252525",
        "Bright": "#B6ACEF",

        // Overriding the colors in this block in custom themes isn't recommended
        "GreenDark": "#013B11",
        "Green": "#5EB509",
        "Red": "#F95858",
        "Blue": "#3363CB",
        "Yellow": "#E1CB73",
        "Grey": "#DEDEDE80",

        // Alert levels, military style (notification hub ring, minigame overlays).
        // Custom themes should retune these to fit their palette.
        "AlertRed": "#DA343B",
        "AlertAmber": "#F07B1F",
        "AlertYellow": "#DFBB29",
        "AlertWhite": "White",
        "AlertGreen": "Green",

        "MiniExpeditionBackground": "PanelHeader",
